# Copiez ce fichier en .env.local et remplissez avec les valeurs de votre projet Supabase
# (Supabase > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète : uniquement sur le serveur, ne la partagez jamais et ne la mettez pas dans Git.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
